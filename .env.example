# GEMINI_API_KEY: Required for Synora AI server-side capabilities (@google/genai).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional Stripe / M-Pesa billing configuration (server-side only)
STRIPE_SECRET_KEY=""
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
